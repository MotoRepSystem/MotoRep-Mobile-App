<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".LoginEncuestaActivity">

    <!-- LOGO DE MOTO REP ENMANUEL -->

    <ImageView
        android:id="@+id/imgLogoEncuesta"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginTop="65dp"
        android:contentDescription="Logo MotoRep Enmanuel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo_motorep_enmanuel" />

    <!-- TÍTULO -->
    <TextView
        android:id="@+id/txtTituloEncuesta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/roboto"
        android:text="Encuesta de cliente"
        android:textColor="#000000"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgLogoEncuesta" />


    <!-- DESCRIPCIÓN -->

    <TextView
        android:id="@+id/txtDescripcionEncuesta"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:fontFamily="@font/roboto"
        android:gravity="center"
        android:text="Ingrese su usuario para comenzar la encuesta."
        android:textColor="#000000"
        android:textSize="16sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtTituloEncuesta" />

    <!-- CAMPO DE USUARIO -->

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/txtLayoutUsuarioEncuesta"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="25dp"
        android:hint="Usuario"
        android:fontFamily="@font/roboto"
        android:textColorHint="#000000"
        app:boxStrokeColor="#000000"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="2dp"
        app:expandedHintEnabled="false"
        app:hintTextColor="#000000"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtDescripcionEncuesta">


        <!-- ENTRADA DEL USUARIO -->

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/tieUsuarioEncuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:textColor="#000000"
            android:textSize="16sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- BOTÓN CONTINUAR -->

    <Button
        android:id="@+id/btnContinuarEncuesta"
        android:layout_width="200dp"
        android:layout_height="50dp"
        android:layout_marginTop="18dp"
        android:backgroundTint="@color/dark_navy"
        android:fontFamily="@font/roboto"
        android:text="Continuar"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        app:cornerRadius="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/txtLayoutUsuarioEncuesta" />


</androidx.constraintlayout.widget.ConstraintLayout>