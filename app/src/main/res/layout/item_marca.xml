<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    android:background="@color/white">

    <!-- Nombre de la marca -->
    <TextView
        android:id="@+id/txtNombreMarca"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Nombre de la marca"
        android:textColor="#022D36"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtTipoMarca"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Tipo de marca -->
    <TextView
        android:id="@+id/txtTipoMarca"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo de marca"
        android:textColor="#666666"
        android:textSize="13sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Botón para editar la marca -->
    <Button
        android:id="@+id/btnEditarMarca"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:text="Editar"
        android:textAllCaps="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtNombreMarca" />

    <!-- Botón para eliminar la marca -->
    <Button
        android:id="@+id/btnEliminarMarca"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_marginStart="8dp"
        android:text="Eliminar"
        android:textAllCaps="false"
        app:layout_constraintStart_toEndOf="@id/btnEditarMarca"
        app:layout_constraintTop_toTopOf="@id/btnEditarMarca" />

    <!-- Separador inferior -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#E0E0E0"
        app:layout_constraintTop_toBottomOf="@id/btnEditarMarca"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
