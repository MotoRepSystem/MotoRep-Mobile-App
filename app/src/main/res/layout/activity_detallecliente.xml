<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/DrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:openDrawer="start">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/mainConstraint"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/linearLayoutMainTitle"
            android:layout_width="0dp"
            android:layout_height="100dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/imgMenu"
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:srcCompat="@drawable/icon_menuacces" />

            <TextView
                android:id="@+id/txtDashboard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Detalles Cliente"
                android:textAlignment="center"
                android:textColor="@color/green_let"
                android:textSize="20sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgnotificacion"
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:srcCompat="@drawable/icon_notificacion"
                />

        </LinearLayout>

        <!-- CONTENIDO DESPLAZABLE RESPONSIVO -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/linearLayoutMainTitle">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="24dp"
                android:background="@color/white">



                <!-- TARJETA -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/mCVProducto"
                    android:layout_width="0dp"
                    android:layout_height="580dp"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="18dp"
                    android:layout_marginEnd="20dp"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="5dp"
                    app:strokeWidth="0dp"
                    app:layout_constraintTop_toBottomOf="@id/linearLayoutMainTitle"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="12dp">

                        <!-- NOMBRE -->

                        <TextView
                            android:id="@+id/lblNombreCliente"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nombre Producto"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <EditText
                            android:id="@+id/edtNombreProducto"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="Ej: Bujia 34x"
                            android:inputType="textCapSentences"
                            android:importantForAutofill="yes"
                            android:autofillHints="name"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblNombreCliente" />

                        <!-- CÓDIGO -->

                        <TextView
                            android:id="@+id/lblCodigo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Codigo"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtNombreProducto" />

                        <EditText
                            android:id="@+id/edtCodigo"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="Ej: 100000f"
                            android:inputType="textCapCharacters"
                            android:importantForAutofill="no"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblCodigo" />

                        <!-- CATEGORÍA -->

                        <TextView
                            android:id="@+id/lblCategoria"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Categoria"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtCodigo" />

                        <AutoCompleteTextView
                            android:id="@+id/edtCategoria"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="EJ: Electricidad"
                            android:inputType="none"
                            android:importantForAutofill="no"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblCategoria" />

                        <!-- PRECIO -->

                        <TextView
                            android:id="@+id/lblPrecio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Precio"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtCategoria" />

                        <EditText
                            android:id="@+id/edtPrecio"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="0.00"
                            android:inputType="numberDecimal"
                            android:importantForAutofill="no"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblPrecio" />

                        <!-- CANTIDAD -->

                        <TextView
                            android:id="@+id/lblCantidad"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Cantidad"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/edtPrecio" />

                        <EditText
                            android:id="@+id/edtCantidad"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginTop="8dp"
                            android:hint="0"
                            android:inputType="number"
                            android:importantForAutofill="no"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:textSize="12sp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/lblCantidad" />

                        <!-- BOTÓN GUARDAR -->

                        <Button
                            android:id="@+id/btnGuardarCliente"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_marginBottom="3dp"
                            android:backgroundTint="@color/green_let"
                            android:text="Guardar Cliente"
                            android:textColor="@android:color/white"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent" />

                        <TextView
                            android:id="@+id/txtimagen"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="31dp"
                            android:fontFamily="@font/roboto"
                            android:text="Seleccionar imagen"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toBottomOf="@+id/edtCantidad" />

                        <ImageView
                            android:id="@+id/imgSubir"
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:layout_marginStart="48dp"
                            android:layout_marginEnd="149dp"
                            android:layout_marginBottom="16dp"
                            app:layout_constraintBottom_toTopOf="@+id/btnGuardarCliente"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/txtimagen"
                            app:srcCompat="@drawable/icon_upload" />

                    </androidx.constraintlayout.widget.ConstraintLayout>

                </com.google.android.material.card.MaterialCardView>



            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

